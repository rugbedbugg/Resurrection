# Build output
/build/
/build-*/
*.o
*.a
*.so
*.so.*

# Experiment binaries: sources are tracked, compiled probes are not.
# Listed per-file for phase 0 originally; the glob covers every phase.
/experiments/phase*/probe_*
/experiments/phase*/spike_*
!/experiments/phase*/probe_*.c
!/experiments/phase*/spike_*.c

# Benchmark / experiment output
/experiments/raw/*
!/experiments/raw/.gitkeep

# Checkpoint images, their target-output sidecars, profile DBs, fault traces
*.arimg
*.arimg.stdout
*.arimg.stderr
*.arprof
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*faults.tsv

# Editor / tooling
compile_commands.json
.cache/
.idea/
.vscode/
*.swp

# Nix
/result
/result-*
/.direnv/
